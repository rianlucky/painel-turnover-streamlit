# Copie para .streamlit/secrets.toml (local) ou cole nos Secrets do Streamlit Cloud.
# secrets.toml está no .gitignore — nunca versionar com a senha real.
# Usuário de banco só de leitura: acessa apenas a view do painel e a data da última carga.
[neon]
database_url = "postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require&channel_binding=require"
